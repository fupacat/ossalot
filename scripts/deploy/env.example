# /etc/ossalot/env, mode 0600. Read by ossalot.service and ossalot-update.service.
# Token the app uses for GitHub (repo scope on your repositories)
GITHUB_TOKEN=
# Token gh uses to download CI artifacts (read access to fupacat/ossalot, Actions: read)
GH_TOKEN=
OSSALOT_ADDR=127.0.0.1:8080
OSSALOT_DB_PATH=/opt/ossalot/data/ossalot.db
